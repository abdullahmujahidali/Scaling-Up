---
import Base from '../../layouts/Base.astro';
import body from '../../content-html/reference/dva-booking-guide.html?raw';
const headExtra = `<style>
  .step { border-left: 3px solid #9b1c1c; padding: 0.6rem 0 0.6rem 1rem; margin: 1.1rem 0; }
  .step h3 { margin: 0 0 0.4rem 0; }
  .stepnum { display:inline-block; background:#9b1c1c; color:#fff; border-radius:50%; width:1.5rem; height:1.5rem;
             text-align:center; line-height:1.5rem; font-size:0.8rem; font-weight:700; margin-right:0.4rem; }
</style>`;
---
<Base title={"How to book the DVA-C02 exam — step by step"} headExtra={headExtra}>
  <Fragment set:html={body} />
</Base>
